# RevenueCat public SDK keys (publishable, safe for client). Get them from your RevenueCat dashboard.
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=
# OpenAI API key used by the AI chat and lineup optimizer. Supplied at build time, never committed.
EXPO_PUBLIC_OPENAI_API_KEY=
# Dev-only: set to true to unlock Pro features locally without a RevenueCat account.
# Ignored in production builds.
EXPO_PUBLIC_BYPASS_PAYWALL=
